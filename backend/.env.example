DATABASE_URL=postgresql+psycopg2://recovery:recovery@localhost:5432/revenue_recovery
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_LIVE_LLM_TESTS=false

# Client-side pacing for Gemini calls (app/llm_resilience.py). Free tiers
# enforce a per-minute cap - pace under it instead of eating 429s mid-batch.
# 0 disables the limiter entirely.
LLM_REQUESTS_PER_MINUTE=15
# Retry with exponential backoff for transient errors (429/5xx/timeouts).
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=2.0

# Verifies POST /webhooks/razorpay's X-Razorpay-Signature header (HMAC-
# SHA256 of the raw body). Empty skips verification so the demo endpoint
# works without provisioning a secret.
RAZORPAY_WEBHOOK_SECRET=

# Opt-in per-merchant auth (X-API-Key header) for POST /batches/run. Off
# by default to keep judge/demo access frictionless.
REQUIRE_MERCHANT_API_KEY=false
